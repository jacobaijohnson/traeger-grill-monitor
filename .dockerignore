# Dependencies (rebuilt in container)
node_modules/

# Build output (rebuilt in container)
dist/

# Development files
.manus-logs/
.webdev/
.git/
.gitignore

# Session artifacts (DSS guardrail)
screenshot-*.md
screenshot-*.txt
design-notes.md
*-observations.md

# Documentation (not needed in image)
*.md
!README.md
!ENV_TEMPLATE.md

# Audit/analysis scripts
*.sh
!root/**/*.sh

# IDE / Editor
.vscode/
.idea/
*.swp
*.swo
*~

# OS files
.DS_Store
Thumbs.db

# Docker files (avoid recursive builds)
Dockerfile
Dockerfile.*
docker-compose*.yml
.dockerignore

# Config directory (runtime volume)
config/

# Test files (not needed in production)
tests/
**/*.test.ts
**/*.spec.ts
**/__tests__/
vitest.config.*
coverage/
.nyc_output/

# CI/CD files
.github/
.gitlab-ci.yml
.travis.yml

# Environment files (secrets injected at runtime)
.env
.env.*

# Misc development artifacts
*.log
*.tgz
*.tar.gz
npm-debug.log*
pnpm-debug.log*
