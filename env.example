# ─── Traeger Smoker Insight — Environment Variables ──────
#
# Copy this file to .env and fill in the values:
#   cp env.example .env
#
# All variables with defaults are optional.
# Variables marked REQUIRED must be set before first boot.

# ─── REQUIRED ────────────────────────────────────────────

# Random 64-character hex string for session signing.
# Generate with: openssl rand -hex 32
JWT_SECRET=

# Admin account created on first boot.
# Can be removed from .env after initial setup.
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me-immediately

# ─── Database ────────────────────────────────────────────

# MySQL connection string.
# Default uses the bundled MySQL container from docker-compose.yml.
# For external MySQL/MariaDB, set your own connection string.
# DATABASE_URL=mysql://traeger:traeger_pass@mysql:3306/traeger_dashboard

# Password for the bundled MySQL container.
# Only used if running the mysql service from docker-compose.yml.
MYSQL_PASSWORD=traeger_pass
MYSQL_ROOT_PASSWORD=rootpass

# ─── Application ─────────────────────────────────────────

# Set to your external URL when behind a reverse proxy.
# Required for OAuth callbacks and cookie domain.
# BETTER_AUTH_URL=https://grill.example.com

# Timezone (IANA format)
TZ=America/Los_Angeles

# LinuxServer.io user/group IDs
PUID=1000
PGID=1000

# ─── Log Aggregation (optional) ─────────────────────────
# Only used with docker-compose.logging.yml overlay

# Grafana admin credentials (change on first login)
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=admin

# Grafana port (default 3100 to avoid conflicts)
GRAFANA_PORT=3100
