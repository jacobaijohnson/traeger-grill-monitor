#!/usr/bin/with-contenv bash
# shellcheck shell=bash

echo "─── Traeger Grill Monitor: Initializing ───"

# Ensure /config directory exists and has correct ownership
mkdir -p /config

# Set ownership of config directory to abc user (PUID/PGID)
lsiown -R abc:abc /config

# Set ownership of app directory
lsiown -R abc:abc /app

# ─── Database Migrations ─────────────────────────────────
# Run migrations if DATABASE_URL is set.
# This creates Better Auth tables (user, session, account, verification)
# and all application tables (traeger_sessions, telemetry_readings, etc.)
# Idempotent: safe to run on every container start.
if [ -n "${DATABASE_URL}" ]; then
    echo "─── Traeger Grill Monitor: Running database migrations ───"

    # Change to /app BEFORE the MySQL check so node can find mysql2 in node_modules
    cd /app

    # Wait for MySQL to be ready (up to 60 seconds)
    RETRIES=0
    MAX_RETRIES=30
    until node --input-type=module -e "
      import mysql from 'mysql2/promise';
      const c = await mysql.createConnection(process.env.DATABASE_URL);
      await c.end();
    " 2>/dev/null; do
        RETRIES=$((RETRIES + 1))
        if [ "${RETRIES}" -ge "${MAX_RETRIES}" ]; then
            echo "─── Traeger Grill Monitor: WARNING — MySQL not ready after ${MAX_RETRIES} attempts ───"
            echo "─── Traeger Grill Monitor: Skipping migrations, app may fail to start ───"
            break
        fi
        echo "─── Traeger Grill Monitor: Waiting for MySQL... (attempt ${RETRIES}/${MAX_RETRIES}) ───"
        sleep 2
    done

    if [ "${RETRIES}" -lt "${MAX_RETRIES}" ]; then
        # Map JWT_SECRET to BETTER_AUTH_SECRET if not already set
        if [ -z "${BETTER_AUTH_SECRET}" ] && [ -n "${JWT_SECRET}" ]; then
            export BETTER_AUTH_SECRET="${JWT_SECRET}"
        fi

        node dist/migrate.js
        MIGRATE_EXIT=$?
        if [ "${MIGRATE_EXIT}" -ne 0 ]; then
            echo "─── Traeger Grill Monitor: WARNING — Migration exited with code ${MIGRATE_EXIT} ───"
        else
            echo "─── Traeger Grill Monitor: Migrations complete ✓ ───"
        fi
    fi
else
    echo "─── Traeger Grill Monitor: DATABASE_URL not set, skipping migrations ───"
fi

echo "─── Traeger Grill Monitor: Config initialized ───"
