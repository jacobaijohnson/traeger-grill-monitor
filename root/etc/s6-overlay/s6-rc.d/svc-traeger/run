#!/usr/bin/with-contenv bash
# shellcheck shell=bash

# Map JWT_SECRET to BETTER_AUTH_SECRET if not already set
if [ -z "${BETTER_AUTH_SECRET}" ] && [ -n "${JWT_SECRET}" ]; then
    export BETTER_AUTH_SECRET="${JWT_SECRET}"
fi

echo "Starting Traeger Grill Monitor on port ${PORT:-8420}..."

cd /app

# s6-setuidgid drops to the abc user (respects PUID/PGID)
# HEALTHCHECK in Dockerfile handles readiness for orchestrators
exec \
    s6-setuidgid abc \
        node dist/index.js
